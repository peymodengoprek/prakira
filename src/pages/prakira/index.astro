---
import BaseLayout from '../../layout/BaseLayout.astro';
---

<BaseLayout>
  <div class="min-h-screen flex flex-col">
    <main class="flex-1 py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto w-full space-y-6">

        <!-- Page title -->
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Prediksi tagihan</h1>
          <p class="text-sm opacity-80 mt-1 max-w-2xl">
            Tambahkan data pemakaian bulanan. Estimasi dan grafik diperbarui otomatis.
          </p>
        </div>

        <!-- KPI row -->
        <section aria-label="Ringkasan" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="border rounded-lg p-5 shadow-sm sm:col-span-1">
            <p class="text-sm opacity-70">Prediksi bulan berikutnya</p>
            <div class="mt-2 flex items-baseline gap-2 flex-wrap">
              <span id="prediksi-tagihan" class="text-2xl sm:text-3xl font-extrabold tracking-tight">Rp 0</span>
              <span id="prediksi-delta" class="text-xs font-medium border px-2 py-0.5 rounded-full">+5%</span>
            </div>
            <p class="text-xs opacity-70 mt-2">
              Sekitar <strong id="prediksi-kwh">0 kWh</strong>, berdasarkan data bulan terakhir.
            </p>
          </div>

          <div class="border rxounded-lg p-5 shadow-sm">
            <p class="text-sm opacity-70">Rata-rata tagihan</p>
            <p id="kpi-avg" class="mt-2 text-2xl font-bold tracking-tight">Rp 0</p>
            <p class="text-xs opacity-70 mt-2">Dari <span id="kpi-count">0</span> bulan data</p>
          </div>

          <div class="border rounded-lg p-5 shadow-sm">
            <p class="text-sm opacity-70">Total pemakaian</p>
            <p id="kpi-kwh" class="mt-2 text-2xl font-bold tracking-tight">0 kWh</p>
            <p class="text-xs opacity-70 mt-2">Akumulasi seluruh dataset</p>
          </div>
        </section>

        <!-- Workspace -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

          <!-- Main: chart + table -->
          <div class="lg:col-span-8 space-y-6 order-2 lg:order-1">

            <section class="border rounded-lg shadow-sm">
              <div class="flex items-center justify-between px-5 py-4 border-b">
                <h2 class="text-sm font-semibold">Tren tagihan</h2>
                <span class="text-xs opacity-70">Diperbarui langsung</span>
              </div>
              <div class="p-5">
                <div class="w-full h-72">
                  <canvas id="prakiraChart"></canvas>
                </div>
              </div>
            </section>

            <section class="border rounded-lg shadow-sm">
              <div class="flex items-center justify-between px-5 py-4 border-b">
                <h2 class="text-sm font-semibold">Data historis</h2>
                <span class="text-xs opacity-70"><span id="total-dataset">0</span> bulan</span>
              </div>

              <div class="overflow-x-auto">
                <table class="min-w-full divide-y text-left text-sm">
                  <thead>
                    <tr class="text-xs font-medium opacity-70">
                      <th class="py-3 px-5 font-medium">Bulan</th>
                      <th class="py-3 px-5 font-medium">Pemakaian</th>
                      <th class="py-3 px-5 font-medium">Tagihan</th>
                      <th class="py-3 px-5 font-medium text-right">Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="table-body" class="divide-y"></tbody>
                </table>
              </div>
            </section>
          </div>

          <!-- Side: input form (sticky) -->
          <aside class="lg:col-span-4 order-1 lg:order-2 lg:sticky lg:top-20">
            <section class="border rounded-lg shadow-sm">
              <div class="px-5 py-4 border-b">
                <h2 id="form-title" class="text-sm font-semibold">Tambah data bulanan</h2>
                <p class="text-xs opacity-70 mt-0.5">Isi pemakaian dan tagihan untuk satu bulan.</p>
              </div>

              <form id="prakira-form" class="p-5 space-y-4">
                <div>
                  <label for="bulan" class="block text-sm font-medium mb-1.5">Bulan</label>
                  <select
                    id="bulan"
                    class="w-full px-3 py-2.5 border rounded-md text-sm focus:outline-none bg-transparent cursor-pointer"
                    required
                  >
                    <option value="" disabled selected>Pilih bulan</option>
                    <option value="Januari">Januari</option>
                    <option value="Februari">Februari</option>
                    <option value="Maret">Maret</option>
                    <option value="April">April</option>
                    <option value="Mei">Mei</option>
                    <option value="Juni">Juni</option>
                    <option value="Juli">Juli</option>
                    <option value="Agustus">Agustus</option>
                    <option value="September">September</option>
                    <option value="Oktober">Oktober</option>
                    <option value="November">November</option>
                    <option value="Desember">Desember</option>
                  </select>
                </div>

                <div>
                  <label for="penggunaan" class="block text-sm font-medium mb-1.5">Pemakaian</label>
                  <div class="relative">
                    <input
                      type="number"
                      id="penggunaan"
                      min="0"
                      placeholder="150"
                      class="w-full pl-3 pr-14 py-2.5 border rounded-md text-sm focus:outline-none"
                      required
                    />
                    <span class="absolute inset-y-0 right-3 flex items-center text-xs opacity-60 pointer-events-none">kWh</span>
                  </div>
                </div>

                <div>
                  <label for="tagihan" class="block text-sm font-medium mb-1.5">Tagihan</label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-3 flex items-center text-xs opacity-60 pointer-events-none">Rp</span>
                    <input
                      type="number"
                      id="tagihan"
                      min="0"
                      placeholder="180000"
                      class="w-full pl-10 pr-3 py-2.5 border rounded-md text-sm focus:outline-none"
                      required
                    />
                  </div>
                </div>

                <div class="pt-1 flex gap-2">
                  <button
                    type="submit"
                    id="submit-btn"
                    class="flex-1 rounded-md py-2.5 font-medium text-sm transition-all cursor-pointer border shadow-sm bg-primary text-white hover:bg-accent duration-300"
                  >
                    Tambah data
                  </button>
                  <button
                    type="button"
                    id="cancel-btn"
                    class="hidden rounded-md px-4 py-2.5 font-medium text-sm transition-all cursor-pointer border"
                  >
                    Batal
                  </button>
                </div>
              </form>
            </section>
          </aside>

        </div>
      </div>
    </main>

    <footer class="border-t py-4 px-4 text-center text-xs opacity-60">
      Prakira Engine v1.0 · Estimasi bersifat perkiraan
    </footer>
  </div>
</BaseLayout>

<!-- Load Chart.js CDN dari CDNJS -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<!-- Script Logika & Chart -->
<script>
  let items = [
    
  ];

  const form = document.getElementById('prakira-form') as HTMLFormElement;
  const tableBody = document.getElementById('table-body');
  const totalDatasetEl = document.getElementById('total-dataset');
  const prediksiTagihanEl = document.getElementById('prediksi-tagihan');
  const prediksiKwhEl = document.getElementById('prediksi-kwh');
  const prediksiDeltaEl = document.getElementById('prediksi-delta');
  const kpiAvgEl = document.getElementById('kpi-avg');
  const kpiCountEl = document.getElementById('kpi-count');
  const kpiKwhEl = document.getElementById('kpi-kwh');
  const formTitleEl = document.getElementById('form-title');
  const submitBtn = document.getElementById('submit-btn');
  const cancelBtn = document.getElementById('cancel-btn');

  let myChart: any = null;
  let editingIndex: number | null = null;

  const rupiah = (n: number) => `Rp ${n.toLocaleString('id-ID')}`;

  function initOrUpdateChart() {
    const canvas = document.getElementById('prakiraChart') as HTMLCanvasElement;
    if (!canvas) return;

    const labels = items.map(item => item.bulan);
    const dataTagihan = items.map(item => item.tagihan);

    if (myChart) {
      myChart.data.labels = labels;
      myChart.data.datasets[0].data = dataTagihan;
      myChart.update();
    } else {
      myChart = new (window as any).Chart(canvas, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Tagihan (Rp)',
            data: dataTagihan,
            borderColor: '#38BDF8',
            backgroundColor: 'rgba(56, 189, 248, 0.1)',
            borderWidth: 2,
            fill: true,
            tension: 0.3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: { beginAtZero: false }
          }
        }
      });
    }
  }

  function renderTable() {
    if (!tableBody) return;
    tableBody.innerHTML = '';

    if (items.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="4" class="py-12 px-5 text-center">
            <p class="text-sm font-medium">Belum ada data</p>
            <p class="text-xs opacity-60 mt-1">Isi formulir di samping untuk menambahkan bulan pertama.</p>
          </td>
        </tr>
      `;
    } else {
      items.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="py-3 px-5 font-medium">${item.bulan}</td>
          <td class="py-3 px-5">${item.penggunaan} kWh</td>
          <td class="py-3 px-5">${rupiah(item.tagihan)}</td>
          <td class="py-3 px-5 text-right">
            <div class="inline-flex">
              <button
                data-index="${index}"
                class="btn-edit -ms-px rounded-s-md border border-gray-200 px-3 py-2 text-gray-700 transition-colors hover:bg-gray-50 cursor-pointer"
                aria-label="Edit ${item.bulan}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 pointer-events-none">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                </svg>
              </button>
              <button
                data-index="${index}"
                class="btn-delete -ms-px rounded-e-md border border-gray-200 px-3 py-2 text-gray-700 transition-colors hover:bg-gray-50 cursor-pointer"
                aria-label="Hapus ${item.bulan}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 pointer-events-none">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              </button>
            </div>
          </td>
        `;
        tableBody.appendChild(tr);
      });
    }

    if (totalDatasetEl) totalDatasetEl.textContent = items.length.toString();
    updatePrediction();
    updateKpis();
    initOrUpdateChart();
  }

  function updatePrediction() {
    if (items.length > 0) {
      const last = items[items.length - 1];
      const estTagihan = Math.round(last.tagihan * 1.05);
      const estKwh = Math.round(last.penggunaan * 1.03);

      if (prediksiTagihanEl) prediksiTagihanEl.textContent = rupiah(estTagihan);
      if (prediksiKwhEl) prediksiKwhEl.textContent = `${estKwh} kWh`;
      if (prediksiDeltaEl) prediksiDeltaEl.textContent = '+5% dari bulan lalu';
    } else {
      if (prediksiTagihanEl) prediksiTagihanEl.textContent = 'Rp 0';
      if (prediksiKwhEl) prediksiKwhEl.textContent = '0 kWh';
      if (prediksiDeltaEl) prediksiDeltaEl.textContent = '-';
    }
  }

  function updateKpis() {
    const count = items.length;
    const totalKwh = items.reduce((s, i) => s + i.penggunaan, 0);
    const avg = count ? Math.round(items.reduce((s, i) => s + i.tagihan, 0) / count) : 0;

    if (kpiAvgEl) kpiAvgEl.textContent = rupiah(avg);
    if (kpiCountEl) kpiCountEl.textContent = count.toString();
    if (kpiKwhEl) kpiKwhEl.textContent = `${totalKwh.toLocaleString('id-ID')} kWh`;
  }

  function setEditMode(index: number | null) {
    editingIndex = index;
    const editing = index !== null;
    if (formTitleEl) formTitleEl.textContent = editing ? 'Ubah data bulanan' : 'Tambah data bulanan';
    if (submitBtn) submitBtn.textContent = editing ? 'Simpan perubahan' : 'Tambah data';
    cancelBtn?.classList.toggle('hidden', !editing);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const bulanInput = document.getElementById('bulan') as HTMLSelectElement;
    const penggunaanInput = document.getElementById('penggunaan') as HTMLInputElement;
    const tagihanInput = document.getElementById('tagihan') as HTMLInputElement;

    if (!bulanInput.value || !penggunaanInput.value || !tagihanInput.value) return;

    const entry = {
      bulan: bulanInput.value,
      penggunaan: Number(penggunaanInput.value),
      tagihan: Number(tagihanInput.value)
    };

    if (editingIndex !== null) {
      items[editingIndex] = entry;
    } else {
      items.push(entry);
    }

    form.reset();
    setEditMode(null);
    renderTable();
  });

  cancelBtn?.addEventListener('click', () => {
    form.reset();
    setEditMode(null);
  });

  tableBody?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const editBtn = target.closest('.btn-edit') as HTMLButtonElement;
    const deleteBtn = target.closest('.btn-delete') as HTMLButtonElement;

    if (deleteBtn) {
      const index = Number(deleteBtn.dataset.index);
      items.splice(index, 1);
      if (editingIndex !== null) {
        form.reset();
        setEditMode(null);
      }
      renderTable();
    } else if (editBtn) {
      const index = Number(editBtn.dataset.index);
      const item = items[index];

      (document.getElementById('bulan') as HTMLSelectElement).value = item.bulan;
      (document.getElementById('penggunaan') as HTMLInputElement).value = item.penggunaan.toString();
      (document.getElementById('tagihan') as HTMLInputElement).value = item.tagihan.toString();

      setEditMode(index);
      form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  // Render awal saat halaman dimuat
  renderTable();
</script>