---
import BaseLayout from '../../layout/BaseLayout.astro';
import PageHeading from '../../components/prakira/PageHeading.astro';
import KpiSummary from '../../components/prakira/KpiSummary.astro';
import TrendChart from '../../components/prakira/TrendChart.astro';
import HistoryTable from '../../components/prakira/HistoryTable.astro';
import DataForm from '../../components/prakira/DataForm.astro';
import PrakiraScript from '../../components/prakira/script.astro';
---

<BaseLayout>
  <div class="min-h-screen flex flex-col">
    <main class="flex-1 py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto w-full space-y-6">
        <PageHeading />
        <KpiSummary />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          <div class="lg:col-span-8 space-y-6 order-2 lg:order-1">
            <TrendChart />
            <HistoryTable />
          </div>

          <aside class="lg:col-span-4 order-1 lg:order-2 lg:sticky lg:top-20">
            <DataForm />
          </aside>
        </div>
      </div>
    </main>

    <footer class="border-t py-4 px-4 text-center text-xs opacity-60">
      Prakira Engine v1.0 · Estimasi bersifat perkiraan
    </footer>
  </div>
</BaseLayout>

<PrakiraScript />