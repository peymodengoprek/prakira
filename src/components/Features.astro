          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
          />
        </svg>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-secondary">Transparan &amp; Terarah</h3>

        <p class="mt-2 text-pretty text-secondary/70">
          Pahami pola konsumsi energi rumah atau tempat usahamu dengan lebih baik agar pengeluaran bulanan lebih terencana.
        </p>
      </div>
    </div>
  </div>
