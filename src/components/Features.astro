<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8" id="features">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    <!-- Estimasi Presisi Tinggi -->
    <div class="flex items-start gap-4 rounded-lg border border-accent/30 bg-theme-white p-6">
      <div class="inline-flex rounded-lg bg-accent/15 p-3 text-primary">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="12" cy="12" r="5" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="12" cy="12" r="1" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-secondary">Hasil Presisi</h3>

        <p class="mt-2 text-pretty text-secondary/70">
          Dirancang khusus untuk memproyeksikan estimasi tagihan bulan ke-6 secara akurat berdasarkan tren data 5 bulan terakhirmu.
        </p>
      </div>
    </div>

    <!-- Visualisasi Data yang Jelas -->
    <div class="flex items-start gap-4 rounded-lg border border-accent/30 bg-theme-white p-6">
      <div class="inline-flex rounded-lg bg-accent/15 p-3 text-primary">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"
          />
        </svg>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-secondary">Visualisasi Data yang Jelas</h3>

        <p class="mt-2 text-pretty text-secondary/70">
          Lihat pergerakan pemakaian listrikmu dalam bentuk grafik yang mudah dibaca tanpa istilah rumit yang membingungkan.
        </p>
      </div>
    </div>

    <!-- Proses Instan -->
    <div class="flex items-start gap-4 rounded-lg border border-accent/30 bg-theme-white p-6">
      <div class="inline-flex rounded-lg bg-accent/15 p-3 text-primary">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z"
          />
        </svg>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-secondary">Proses Instan</h3>

        <p class="mt-2 text-pretty text-secondary/70">
          Masukkan data historis pemakaian dengan mudah dan dapatkan hasil kalkulasi estimasi tarif listrik dalam hitungan detik.
        </p>
      </div>
    </div>

    <!-- Transparan & Terarah -->
    <div class="flex items-start gap-4 rounded-lg border border-accent/30 bg-theme-white p-6">
      <div class="inline-flex rounded-lg bg-accent/15 p-3 text-primary">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
