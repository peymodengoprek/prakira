---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Prediksi tagihan',
  description = 'Tambahkan data pemakaian bulanan. Estimasi dan grafik diperbarui otomatis.',
} = Astro.props;
---

<div>
  <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">{title}</h1>
  <p class="text-sm opacity-80 mt-1 max-w-2xl">{description}</p>
</div>