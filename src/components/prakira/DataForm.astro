---
const bulan = [
  'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
  'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember',
];
---

<section class="border rounded-lg shadow-sm">
  <div class="px-5 py-4 border-b">
    <h2 id="form-title" class="text-sm font-semibold">Tambah data bulanan</h2>
    <p class="text-xs opacity-70 mt-0.5">Isi pemakaian dan tagihan untuk satu bulan.</p>
  </div>

  <form id="prakira-form" class="p-5 space-y-4">
    <div>
      <label for="bulan" class="block text-sm font-medium mb-1.5">Bulan</label>
      <select
        id="bulan"
        class="w-full px-3 py-2.5 border rounded-md text-sm focus:outline-none bg-transparent cursor-pointer"
        required
      >
        <option value="" disabled selected>Pilih bulan</option>
        {bulan.map((b) => <option value={b}>{b}</option>)}
      </select>
    </div>

    <div>
      <label for="penggunaan" class="block text-sm font-medium mb-1.5">Pemakaian</label>
      <div class="relative">
        <input
          type="number"
          id="penggunaan"
          min="0"
          placeholder="150"
          class="w-full pl-3 pr-14 py-2.5 border rounded-md text-sm focus:outline-none"
          required
        />
        <span class="absolute inset-y-0 right-3 flex items-center text-xs opacity-60 pointer-events-none">kWh</span>
      </div>
    </div>

    <div>
      <label for="tagihan" class="block text-sm font-medium mb-1.5">Tagihan</label>
      <div class="relative">
        <span class="absolute inset-y-0 left-3 flex items-center text-xs opacity-60 pointer-events-none">Rp</span>
        <input
          type="number"
          id="tagihan"
          min="0"
          placeholder="180000"
          class="w-full pl-10 pr-3 py-2.5 border rounded-md text-sm focus:outline-none"
          required
        />
      </div>
    </div>

    <div class="pt-1 flex gap-2">
      <button
        type="submit"
        id="submit-btn"
        class="flex-1 rounded-md py-2.5 font-medium text-sm transition-all cursor-pointer border shadow-sm bg-primary text-white hover:bg-accent duration-300"
      >
        Tambah data
      </button>
      <button
        type="button"
        id="cancel-btn"
        class="hidden rounded-md px-4 py-2.5 font-medium text-sm transition-all cursor-pointer border"
      >
        Batal
      </button>
    </div>
  </form>
</section>