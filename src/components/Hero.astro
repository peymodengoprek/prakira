---
import petir from "../../public/icon-petir-kalkulator.svg";
---

<section class="hero relative isolate lg:grid lg:place-content-center overflow-x-hidden">
  <!-- Background kotak-kotak semi transparan -->
  <div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto w-screen max-w-7xl px-8 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-5 lg:grid-cols-2 ">
      <!-- Kolom Teks -->
      <div class="max-w-prose col-1 mb-10">
        <h1 class="text-4xl font-bold sm:text-5xl">
          Kendalikan Tagihan Listrik, <strong class="text-primary"> Prediksi </strong> Tanpa Cemas.
        </h1>

        <p class="mt-4 text-base text-pretty text-secondary sm:text-lg/relaxed">
          Estimasikan biaya listrik bulan depan berdasarkan data historis pemakaianmu. Akurat, cepat, dan transparan.
        </p>

        <div class="mt-4 flex flex-wrap gap-4 sm:mt-6">
          <a
            class="inline-block rounded border border-primary bg-primary px-5 py-3 font-medium text-white shadow-sm transition-colors hover:border-accent hover:bg-white duration-300 hover:text-secondary"
            href="/prakira/"
          >
            Mulai Prediksi Sekarang
          </a>

          <a
            class="inline-block rounded border border-accent bg-[#F8FAFC] px-5 py-3 font-medium text-secondary shadow-sm transition-colors hover:border-accent hover:bg-white hover:text-primary duration-300"
            href="#features"
          >
            Pelajari Cara Kerjanya
          </a>
        </div>
      </div>

      <!-- Kolom Ilustrasi -->
      <div class="relative isolate lg:place-self-end">
        <!-- Glow di belakang ikon -->
        <div class="hero-glow pointer-events-none absolute left-1/2 top-1/2 -z-10 size-72 -translate-x-1/2 -translate-y-1/2 sm:size-96 lg:size-[28rem]" aria-hidden="true"></div>

        <img
          src={petir.src}
          width={384}
          height={384}
          loading="eager"
          alt="Maskot petir lucu Prakira dengan kalkulator"
          class="hero-float mx-auto size-64 object-contain sm:size-80 lg:size-96"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Kotak-kotak: garis tipis biru, memudar ke arah tepi */
  .hero-grid {
    background-image:
      linear-gradient(to right, rgb(37 99 235 / 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(37 99 235 / 0.08) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 40%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 40%, transparent 100%);
  }

  /* Glow biru lembut */
  .hero-glow {
    background: radial-gradient(
      circle,
      rgb(37 99 235 / 0.45) 0%,
      rgb(96 165 250 / 0.25) 40%,
      transparent 70%
    );
    filter: blur(40px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-float {
      animation: hero-float 4s ease-in-out infinite;
    }

    .hero-glow {
      animation: hero-glow 4s ease-in-out infinite;
    }
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @keyframes hero-glow {
    0%,
    100% {
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
  }
</style>