---

<header class="sticky top-0 w-full border-b border-accent/20 bg-[#F8FAFC] z-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="md:flex md:items-center md:gap-12">
        <a class="flex items-center gap-2 text-[#2563EB]" href="#">
          <span class="sr-only">Home</span>
          <svg
            class="h-8 w-8"
            viewBox="0 0 24 24"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M14.615 1.595a.75.75 0 0 1 .359.852L12.982 9.75h7.268a.75.75 0 0 1 .548 1.262l-10.5 11.25a.75.75 0 0 1-1.272-.71l1.992-7.302H3.75a.75.75 0 0 1-.548-1.262l10.5-11.25a.75.75 0 0 1 .913-.143Z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-lg font-bold tracking-tight text-[#0F172A]" aria-hidden="true">
            <span class="text-[#2563EB]">Prakira</span>
          </span>
        </a>
      </div>

      <div class="flex items-center gap-4">
        <div class="sm:flex sm:gap-4">
          <a
            class="rounded-md bg-[#2563EB] px-5 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[#38BDF8] hover:text-[#0F172A]"
            href="#"
          >
            Login
          </a>

          <div class="hidden sm:flex">
            <a
              class="rounded-md border border-[#2563EB]/20 bg-[#F8FAFC] px-5 py-2.5 text-sm font-medium text-[#2563EB] transition-colors hover:border-[#38BDF8] hover:text-[#38BDF8]"
              href="#"
            >
              Register
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>